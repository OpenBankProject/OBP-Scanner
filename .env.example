# --- OBP-API -------------------------------------------------------------------
OBP_BASE_URL=http://localhost:8080

# OBP-Scanner calls OBP-API as a Platform App, with its own application token (OAuth2 client credentials).
# In the TESOBE dev setup /srv/work/workspace_2026/commands/_helpers/sync_obp_consumers.sh creates the
# client "obp-scanner" and writes these two values.
OIDC_ISSUER=http://localhost:9000/obp-oidc
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# The spaces whose files are scanned (bank ids, or SYS), comma separated. OBP-Scanner declares the Scope
# CanUpdateFileScanStatusAtOneBank at each; an administrator grants them on the API Manager's Platform Apps page.
SCANNER_BANK_IDS=cohort

# How often to look for files waiting to be scanned, and the most per space per pass
SCANNER_POLL_SECONDS=30
SCANNER_BATCH_SIZE=50

# --- Engine: ClamAV's daemon ------------------------------------------------------
# A file is marked clean only when clamd says so; while clamd is unreachable, files stay pending.
CLAMD_HOST=localhost
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=60

# --- Status page ------------------------------------------------------------------
SCANNER_WEB_HOST=127.0.0.1
SCANNER_WEB_PORT=8767
